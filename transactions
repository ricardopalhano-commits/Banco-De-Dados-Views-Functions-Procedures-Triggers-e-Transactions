DROP TABLE IF EXISTS contas;

CREATE TABLE contas (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL UNIQUE,
    saldo DECIMAL(10, 2) NOT NULL
);

INSERT INTO contas (nome, saldo) VALUES
    ('Ana', 1000.00),
    ('Carlos', 500.00);

START TRANSACTION;

UPDATE contas
SET saldo = saldo - 300.00
WHERE nome = 'Ana';

UPDATE contas
SET saldo = saldo + 300.00
WHERE nome = 'Carlos';

SELECT nome, saldo FROM contas ORDER BY nome;

COMMIT;

SELECT nome, saldo FROM contas ORDER BY nome;

START TRANSACTION;

UPDATE contas
SET saldo = saldo - 200.00
WHERE nome = 'Carlos';

UPDATE contas
SET saldo = saldo + 200.00
WHERE nome = 'Ana';

SELECT nome, saldo FROM contas ORDER BY nome;

ROLLBACK;

SELECT nome, saldo FROM contas ORDER BY nome;
